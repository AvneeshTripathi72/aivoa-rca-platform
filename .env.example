# ==============================================================================
# AIVOA.AI — Root Cause Analysis (RCA) Module Environment Variables
# ==============================================================================

# Groq Cloud API Key
# Provide your Groq API key below to enable live Llama-3.3-70B inference.
# If left empty, AIVOA runs in high-fidelity Pharmaceutical Domain Demo Mode.
GROQ_API_KEY=

# Groq Models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Database Connection
# SQLite is default for zero-friction local execution:
DATABASE_URL=sqlite:///./aivoa_rca.db
# For PostgreSQL:
# DATABASE_URL=postgresql://aivoa_user:aivoa_password@localhost:5432/aivoa_rca

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Application Environment
PROJECT_NAME="AIVOA.AI — Root Cause Analysis (RCA) Module"
VERSION=1.0.0
